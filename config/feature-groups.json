{
  "configVersion": "fg-2",
  "dataset": {
    "name": "UCI Default of Credit Card Clients",
    "recordIdColumn": "ID",
    "targetColumn": "default payment next month"
  },
  "initialFeatures": ["LIMIT_BAL", "BILL_AMT1", "PAY_AMT1"],
  "providers": [
    {
      "id": "REPAYMENT_HISTORY",
      "description": "Repayment status for the six most recent months",
      "features": ["PAY_0", "PAY_2", "PAY_3", "PAY_4", "PAY_5", "PAY_6"]
    },
    {
      "id": "BILLING_HISTORY",
      "description": "Bill statement amounts for the five preceding months",
      "features": ["BILL_AMT2", "BILL_AMT3", "BILL_AMT4", "BILL_AMT5", "BILL_AMT6"]
    },
    {
      "id": "PAYMENT_HISTORY",
      "description": "Previous payment amounts for the five preceding months",
      "features": ["PAY_AMT2", "PAY_AMT3", "PAY_AMT4", "PAY_AMT5", "PAY_AMT6"]
    }
  ],
  "excludedColumns": ["SEX", "EDUCATION", "MARRIAGE", "AGE"]
}
